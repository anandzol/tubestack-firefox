{
  "name": "tubestack",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && BUILD_TARGET=background vite build && BUILD_TARGET=popup vite build && cp -r assets dist/assets 2>/dev/null; echo 'Build complete!'",
    "build:content": "vite build",
    "build:bg": "BUILD_TARGET=background vite build",
    "build:popup": "BUILD_TARGET=popup vite build"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.0"
  }
}